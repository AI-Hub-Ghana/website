---
interface Props {
  currentPage?: 'home' | 'get-involved';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';

const logoHref = isHome ? '#main' : '/#main';
const registerHref = isHome ? '/get-involved#register' : '#register';
const servicesHref = isHome ? '#corridor' : '/#work';
const aboutHref = isHome ? '#why' : '/#why';

const launchHref = isHome ? '#launch' : '/#launch';
const workHref = isHome ? '#work' : '/#work';
const corridorHref = isHome ? '#corridor' : '/#corridor';
const membershipHref = isHome ? '#membership' : '/#membership';
const partnersHref = isHome ? '#partners' : '/#partners';
---

<!-- =====================================================================
     FOOTER
     ===================================================================== -->
<footer class="bg-ink on-dark text-paper">
  <div class="shell pt-[clamp(44px,4.6vw,72px)] pb-7 flex flex-col gap-11">
    <div class="grid gap-x-9 gap-y-10 sm:grid-cols-2 lg:grid-cols-[230px_minmax(0,1fr)_140px_150px_240px]">

      <div class="flex flex-col gap-4 items-start">
        <!-- PLACEHOLDER LOGOTYPE -->
        <a href={logoHref} class="logotype logotype-light [--lt:24px]" aria-label="AI Hub, Ghana — home">
          <span class="lt-1">AI Hub</span>
          <span class="lt-2">Ghana</span>
        </a>
        <p class="text-[10px] font-extrabold tracking-[0.16em] text-paper/70">ACCRA · OPERATIONS FROM 2026</p>
      </div>

      <p class="text-[13px] leading-[1.7] text-paper/80 max-w-[46ch]">
        A not-for-profit AI innovation centre in Accra, working as a bilateral bridge
        between Ghana's AI ecosystem and European markets. Surpluses are reinvested in
        skills, jobs and businesses.
      </p>

      <nav class="flex flex-col gap-2.5" aria-label="The Hub">
        <h2 class="text-[10px] font-extrabold tracking-[0.16em] text-paper/60 mb-1">THE HUB</h2>
        {isHome ? (
          <>
            <a href={launchHref}     class="text-[13px] text-paper/90 hover:text-gold transition-colors">Official launch</a>
            <a href={workHref}       class="text-[13px] text-paper/90 hover:text-gold transition-colors">What we do</a>
            <a href={corridorHref}   class="text-[13px] text-paper/90 hover:text-gold transition-colors">The corridor</a>
            <a href={membershipHref} class="text-[13px] text-paper/90 hover:text-gold transition-colors">Membership</a>
            <a href={partnersHref}   class="text-[13px] text-paper/90 hover:text-gold transition-colors">Partners</a>
          </>
        ) : (
          <>
            <a href={workHref}       class="text-[13px] text-paper/90 hover:text-gold transition-colors">What we do</a>
            <a href={launchHref}     class="text-[13px] text-paper/90 hover:text-gold transition-colors">Official launch</a>
            <a href={corridorHref}   class="text-[13px] text-paper/90 hover:text-gold transition-colors">The corridor</a>
            <a href={membershipHref} class="text-[13px] text-paper/90 hover:text-gold transition-colors">Membership</a>
            <a href={partnersHref}   class="text-[13px] text-paper/90 hover:text-gold transition-colors">Partners</a>
          </>
        )}
      </nav>

      <nav class="flex flex-col gap-2.5" aria-label="Engage">
        <h2 class="text-[10px] font-extrabold tracking-[0.16em] text-paper/60 mb-1">ENGAGE</h2>
        <a href={registerHref} class="text-[13px] text-paper/90 hover:text-gold transition-colors">Register interest</a>
        <a href={servicesHref} class="text-[13px] text-paper/90 hover:text-gold transition-colors">Services in detail</a>
        <a href={aboutHref}    class="text-[13px] text-paper/90 hover:text-gold transition-colors">About</a>
      </nav>

      <div class="flex flex-col gap-3">
        <h2 class="text-[10px] font-extrabold tracking-[0.16em] text-paper/60">CONTACT</h2>
        <a href="mailto:b.janischowsky@4th-ir.com" class="flex items-center gap-2.5 text-[13px] font-semibold text-paper hover:text-gold transition-colors">
          <svg class="w-[15px] h-[15px] text-mint shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-mail"/></svg>
          b.janischowsky@4th-ir.com
        </a>
        <p class="flex items-center gap-2.5 text-[12.5px] text-paper/80">
          <svg class="w-[15px] h-[15px] text-mint shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-map-pin"/></svg>
          Accra, Ghana
        </p>
      </div>
    </div>

    <div class="flex flex-wrap justify-between items-center gap-4 border-t border-paper/15 pt-6">
      <p class="text-[10.5px] tracking-[0.16em] font-bold text-paper/60">© 2026 AI HUB, GHANA</p>
      <div class="flex gap-7">
        <a href="#privacy" class="text-[10.5px] tracking-[0.16em] font-bold text-paper/60 hover:text-gold transition-colors">PRIVACY</a>
        <a href="#imprint" class="text-[10.5px] tracking-[0.16em] font-bold text-paper/60 hover:text-gold transition-colors">IMPRINT</a>
      </div>
    </div>
  </div>
</footer>
