---
// Footer — V2: Light footer for home, minimal for get-involved
interface Props {
  currentPage?: 'home' | 'get-involved' | 'not-found';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
const logoHref = isHome ? '#main' : '/';
const privacyHref = currentPage === 'not-found' ? '/get-involved#privacy' : '#privacy';
---

{isHome && (
  <footer class="site-footer">
    <div class="page-shell">
      <div class="footer-main">
        <a class="brand" href={logoHref} aria-label="Applied AI &amp; Innovation Centre, Ghana — home">
          <img class="brand-logo" src="/images/logo_black.svg" width="296" height="99" alt="Applied AI &amp; Innovation Centre, Ghana">
        </a>
        <p>Accra, Ghana<br>Connecting people and possibilities.</p>
        <a class="text-link" href="mailto:b.janischowsky@4th-ir.com">Contact the Hub</a>
      </div>
      <div class="footer-bottom">
        <span>© 2026 AI Hub, Ghana</span>
        <div>
          <a href="https://www.gabs2026.com/" target="_blank" rel="noopener noreferrer">GABS 2026</a>
          <a href="/get-involved#privacy">Privacy &amp; registration</a>
        </div>
      </div>
    </div>
  </footer>
)}

{!isHome && (
  <footer class="site-footer compact-footer">
    <div class="page-shell participation-footer-inner">
      <p>© 2026 AI Hub, Ghana · Accra</p>
      <nav aria-label="Footer">
        <a href="/">Explore the Hub</a>
        <a href="/#launch">The launch</a>
        <a href={privacyHref}>Data on this page</a>
      </nav>
    </div>
  </footer>
)}

<style>
  .site-footer.compact-footer {
    padding: 0;
  }

  .participation-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding-block: 27px;
    border-top: 1px solid #ccd5cb;
  }

  .participation-footer-inner p,
  .participation-footer-inner a {
    font-size: 12px;
  }

  .participation-footer-inner a {
    text-decoration: none;
  }

  .participation-footer-inner a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
