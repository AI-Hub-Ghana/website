---
interface Props {
  name: string;
  class?: string;
  strokeWidth?: number | string;
  [key: string]: any;
}

const {
  name,
  class: className = 'w-4 h-4',
  strokeWidth = 2,
  ...rest
} = Astro.props;
---
<svg
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  {...rest}
>
  <use href={`#i-${name}`} />
</svg>
