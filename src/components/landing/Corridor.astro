---
// The Corridor section — bilateral bridge connecting Europe and Ghana
---
<!-- =====================================================================
     THE CORRIDOR — Bilateral route
     ===================================================================== -->
<section id="corridor" class="scroll-mt-20 border-t border-hairline bg-paper py-[clamp(48px,6vw,92px)] relative overflow-hidden">
  <div class="shell">
    <!-- Section Header -->
    <div class="flex flex-col gap-3.5 max-w-[54ch] mb-[clamp(32px,4vw,56px)]">
      <p class="kicker reveal">The corridor</p>
      <h2 class="display d-lg text-ink reveal" style="--d:80ms">
        One route. Both directions.
      </h2>
    </div>

    <!-- Bilateral Connected Cards Container -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
      <!-- Europe → Ghana -->
      <div class="bg-mint-tint panel-hook-tr-bl p-[clamp(26px,3vw,44px)] flex flex-col justify-between border border-[#BFD9CD] reveal on-colour shadow-sm">
        <div class="flex flex-col gap-5">
          <div class="flex items-center gap-3">
            <svg class="w-[22px] h-[22px] text-teal shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plane-landing"/></svg>
            <span class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-[#26654D]">Europe &ndash; Ghana</span>
          </div>
          <h3 class="heading text-[clamp(20px,2vw,28px)] text-ink">For European organisations</h3>
        </div>

        <ul class="flex flex-col mt-6">
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold text-ink">Vetted Ghanaian AI professionals and teams</li>
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold text-ink">Cost-effective delivery capacity for practical AI work</li>
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold text-ink">Transparent governance and EU AI Act readiness support</li>
          <li class="border-y border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold text-ink">An on-the-ground presence in Accra</li>
        </ul>
      </div>

      <!-- Ghana → Europe -->
      <div class="bg-coral-tint panel-hook-tl-br p-[clamp(26px,3vw,44px)] flex flex-col justify-between border border-[#E0B0A8] reveal on-colour shadow-sm" style="--d:110ms">
        <div class="flex flex-col gap-5">
          <div class="flex items-center gap-3">
            <svg class="w-[22px] h-[22px] text-[#A83E32] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-plane-takeoff"/></svg>
            <span class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-[#A83E32]">Ghana &ndash; Europe</span>
          </div>
          <h3 class="heading text-[clamp(20px,2vw,28px)] text-ink">For Ghanaian talent and ventures</h3>
        </div>

        <ul class="flex flex-col mt-6">
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold text-ink">European clients and project work</li>
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold text-ink">Training and certification to international standards</li>
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold text-ink">Incubation support for AI-enabled ventures</li>
          <li class="border-y border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold text-ink">Placement on international assignments</li>
        </ul>
      </div>
    </div>
  </div>
</section>
