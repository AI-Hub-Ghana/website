---
// The Corridor section
---
<!-- =====================================================================
     THE CORRIDOR — two directions
     ===================================================================== -->
<section id="corridor" class="shell band scroll-mt-20">
  <div class="flex flex-col gap-[clamp(28px,3.4vw,52px)]">
    <div class="flex flex-col gap-4">
      <p class="kicker reveal">The corridor</p>
      <h2 class="display d-md reveal" style="--d:80ms">
        One route. Both directions.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-4">

      <div class="bg-coral-tint panel-hook-tl-br p-[clamp(26px,3vw,44px)] flex flex-col gap-6 reveal on-colour">
        <div class="flex items-center gap-3">
          <svg class="w-[22px] h-[22px] text-[#A83E32]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-plane-takeoff"/></svg>
          <span class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-[#A83E32]">Accra → Europe</span>
        </div>
        <h3 class="heading text-[clamp(20px,2vw,28px)]">For Ghanaian talent and ventures</h3>
        <ul class="flex flex-col">
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold">European clients and project work</li>
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold">Training and certification to international standards</li>
          <li class="border-t border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold">Incubation support for AI-enabled ventures</li>
          <li class="border-y border-[#E0B0A8] py-[15px] text-[14.5px] font-semibold">Placement on international assignments</li>
        </ul>
      </div>

      <div class="bg-mint-tint panel-hook-tr-bl p-[clamp(26px,3vw,44px)] flex flex-col gap-6 reveal on-colour" style="--d:110ms">
        <div class="flex items-center gap-3">
          <svg class="w-[22px] h-[22px] text-teal" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-plane-landing"/></svg>
          <span class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-[#26654D]">Europe → Accra</span>
        </div>
        <h3 class="heading text-[clamp(20px,2vw,28px)]">For European organisations</h3>
        <ul class="flex flex-col">
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold">Vetted Ghanaian AI professionals</li>
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold">Cost-effective delivery capacity for practical AI work</li>
          <li class="border-t border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold">Transparent governance and EU AI Act readiness</li>
          <li class="border-y border-[#BFD9CD] py-[15px] text-[14.5px] font-semibold">On-the-ground presence in Accra</li>
        </ul>
      </div>
    </div>
  </div>
</section>
