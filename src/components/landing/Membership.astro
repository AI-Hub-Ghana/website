---
// Membership section
---
<!-- =====================================================================
     MEMBERSHIP
     ===================================================================== -->
<section id="membership" class="shell band-sm pb-[clamp(48px,6vw,96px)] scroll-mt-20">
  <div class="grid lg:grid-cols-[minmax(0,46%)_minmax(0,1fr)] gap-x-[clamp(28px,4.5vw,80px)] gap-y-10 items-center">

    <div class="relative min-w-0">
      <div class="absolute accent-tr w-[34%] h-[24%] bg-gold hook-tr hook-s-bl pat-grid pat-sweep pointer-events-none hidden sm:block" style="--pat:#1D1D1B" aria-hidden="true"></div>
      <div class="relative aspect-[5/4] sm:aspect-[4/3] lg:aspect-[9/10] overflow-hidden hook-tl-br">
        <div class="absolute inset-0 overflow-hidden">
          <picture class="w-full h-full block">
            <source srcset="/images/photos/photo-standing.webp" type="image/webp">
            <img src="/images/photos/photo-standing.png" width="1672" height="941" loading="lazy" decoding="async"
                 alt="A team at work in Accra, one colleague standing to talk the others through something"
                 class="w-full h-full object-cover crop-community">
          </picture>
        </div>
        <span class="tag tag-paper absolute left-4 bottom-4 sm:left-6 sm:bottom-6 z-10">Community story 01</span>
      </div>
    </div>

    <div class="flex flex-col gap-7 min-w-0">
      <div class="flex flex-col gap-4">
        <p class="kicker reveal">Membership</p>
        <h2 class="display d-md reveal" style="--d:80ms">
        Built around people who build.
      </h2>
      </div>

      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-5">
        <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:120ms">
          <h3 class="font-bold text-[15px]">A practitioner network</h3>
          <p class="text-[13px] leading-[1.6] text-body">Founders, engineers, researchers and operators working on the same problems.</p>
        </li>
        <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:180ms">
          <h3 class="font-bold text-[15px]">Incubation for early ventures</h3>
          <p class="text-[13px] leading-[1.6] text-body">Support to validate an idea, build with AI tools and reach a first customer faster.</p>
        </li>
        <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:240ms">
          <h3 class="font-bold text-[15px]">Access to the talent pool</h3>
          <p class="text-[13px] leading-[1.6] text-body">Quality-assured professionals matched to European project work.</p>
        </li>
        <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:300ms">
          <h3 class="font-bold text-[15px]">University collaboration</h3>
          <p class="text-[13px] leading-[1.6] text-body">Joint research, student projects and knowledge exchange across both regions.</p>
        </li>
      </ul>

      <a href="/get-involved" class="btn btn-teal self-start mt-1 reveal" style="--d:340ms">
        Join the community <svg class="w-[15px] h-[15px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up-right"/></svg>
      </a>
    </div>
  </div>
</section>
