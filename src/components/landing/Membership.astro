---
// Membership section — Community and participation ecosystem
---
<!-- =====================================================================
     MEMBERSHIP
     ===================================================================== -->
<section id="membership" class="border-t border-hairline bg-paper scroll-mt-20">
  <div class="shell py-[clamp(56px,7vw,104px)]">
    <div class="grid lg:grid-cols-[minmax(0,45%)_minmax(0,1fr)] gap-x-[clamp(32px,5vw,84px)] gap-y-10 items-center">

      <!-- Left: Story Photo with Accent Hook -->
      <div class="relative min-w-0 reveal">
        <div class="absolute accent-tr w-[34%] h-[24%] bg-gold hook-tr hook-s-bl pat-grid pat-sweep pointer-events-none hidden sm:block" style="--pat:#1D1D1B" aria-hidden="true"></div>
        <div class="relative aspect-[5/4] sm:aspect-[4/3] lg:aspect-[1/1] overflow-hidden hook-tl-br shadow-sm">
          <div class="absolute inset-0 overflow-hidden">
            <picture class="w-full h-full block">
              <source srcset="/images/photos/photo-standing.webp" type="image/webp">
              <img src="/images/photos/photo-standing.png" width="1672" height="941" loading="lazy" decoding="async"
                   alt="A team at work in Accra, one colleague standing to talk the others through something"
                   class="w-full h-full object-cover crop-community">
            </picture>
          </div>
          <span class="tag tag-paper absolute left-4 bottom-4 sm:left-6 sm:bottom-6 z-10 shadow-sm">Community story 01</span>
        </div>
      </div>

      <!-- Right: Content & Benefits Grid -->
      <div class="flex flex-col gap-8 min-w-0">
        <div class="flex flex-col gap-3.5">
          <p class="kicker reveal">Membership</p>
          <h2 class="display d-md reveal" style="--d:80ms">
            Built around people who build.
          </h2>
        </div>

        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
          <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:120ms">
            <h3 class="font-bold text-[15.5px] text-ink">A practitioner network</h3>
            <p class="text-[13.5px] leading-[1.6] text-body">Founders, engineers, researchers and operators working on the same problems.</p>
          </li>
          <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:180ms">
            <h3 class="font-bold text-[15.5px] text-ink">Incubation for early ventures</h3>
            <p class="text-[13.5px] leading-[1.6] text-body">Support to validate an idea, build with AI tools and reach a first customer faster.</p>
          </li>
          <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:240ms">
            <h3 class="font-bold text-[15.5px] text-ink">Access to the talent pool</h3>
            <p class="text-[13.5px] leading-[1.6] text-body">Quality-assured professionals matched to European project work.</p>
          </li>
          <li class="flex flex-col gap-1.5 border-t border-hairline pt-4 reveal" style="--d:300ms">
            <h3 class="font-bold text-[15.5px] text-ink">University collaboration</h3>
            <p class="text-[13.5px] leading-[1.6] text-body">Joint research, student projects and knowledge exchange across both regions.</p>
          </li>
        </ul>

        <div class="pt-2 reveal" style="--d:340ms">
          <a href="/get-involved" class="btn btn-teal inline-flex">
            Join the community <svg class="w-[15px] h-[15px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-arrow-up-right"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
