---
// Closing call to action
---
<!-- =====================================================================
     CLOSING CTA — the one call to action
     ===================================================================== -->
<section id="join" class="bg-mint on-colour relative overflow-hidden scroll-mt-20">
  <span class="absolute inset-0 pat-grid pat-sweep pointer-events-none" style="--pat:#1D1D1B" aria-hidden="true"></span>
  <div class="shell band relative flex flex-wrap items-center justify-between gap-x-10 gap-y-9">
    <div class="flex flex-col gap-5 min-w-0">
      <p class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-[#123F2F] reveal">Get involved</p>
      <h2 class="display d-lg reveal" style="--d:80ms">
        Shape the corridor from the start.
      </h2>
      <p class="text-[14.5px] leading-[1.6] text-ink max-w-[46ch] reveal" style="--d:140ms">
        Join as a member, a project partner or a supporter. Registering your
        interest is non-binding and carries no obligation to procure.
      </p>
    </div>
    <a href="/get-involved" class="badge-round reveal shrink-0" style="--d:200ms">
      Register<br>interest
      <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up-right"/></svg>
    </a>
  </div>
</section>
