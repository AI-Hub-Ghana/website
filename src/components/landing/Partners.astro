---
// Partners section
---
<!-- =====================================================================
     PARTNERS
     ===================================================================== -->
<section id="partners" class="scroll-mt-20">
  <div class="shell band-sm">
    <div class="flex flex-col gap-5 max-w-[54ch]">
      <p class="kicker reveal">For partners</p>
      <h2 class="display d-md reveal" style="--d:80ms">
        Anchored in a bilateral network.
      </h2>
      <p class="copy reveal max-w-none" style="--d:140ms">
        Government institutions, universities, chambers of commerce, development
        organisations and companies on both sides, each with a defined role in
        keeping quality and trust in the corridor.
      </p>
      <a href="/get-involved#register" class="btn btn-ink self-start reveal mt-1" style="--d:200ms">
        Start a conversation <svg class="w-[15px] h-[15px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up-right"/></svg>
      </a>
    </div>
  </div>

  <!-- The five roles were a plain white list inside one solid coral panel:
       five near-identical rows, nothing to look at, nothing to enter by. This
       is the colour column set from BRAND-GUIDELINES §9 — one full-bleed
       column per item, no gaps and no radius, the colour change doing the
       dividing, with the icon each role is already assigned in §7. -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-5 mt-[clamp(26px,3vw,44px)]">
    <div class="bg-paper-alt flex flex-col gap-3 p-[clamp(20px,2vw,28px)] reveal" style="--d:0ms">
      <svg class="w-[26px] h-[26px] text-ink" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-landmark"/></svg>
      <h3 class="heading text-[clamp(17px,1.5vw,21px)] text-ink mt-1">Government</h3>
      <p class="text-[13px] leading-[1.55] text-body">Policy alignment with the National AI Strategy.</p>
    </div>
    <div class="bg-mint-tint flex flex-col gap-3 p-[clamp(20px,2vw,28px)] reveal" style="--d:70ms">
      <svg class="w-[26px] h-[26px] text-[#26654D]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-book-open"/></svg>
      <h3 class="heading text-[clamp(17px,1.5vw,21px)] text-ink mt-1">Universities</h3>
      <p class="text-[13px] leading-[1.55] text-body">Research, talent development and responsible AI.</p>
    </div>
    <div class="bg-gold-tint flex flex-col gap-3 p-[clamp(20px,2vw,28px)] reveal" style="--d:140ms">
      <svg class="w-[26px] h-[26px] text-[#7A5C10]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-building-2"/></svg>
      <h3 class="heading text-[clamp(17px,1.5vw,21px)] text-ink mt-1">Business chambers</h3>
      <p class="text-[13px] leading-[1.55] text-body">Market access and member introductions.</p>
    </div>
    <div class="bg-coral-tint flex flex-col gap-3 p-[clamp(20px,2vw,28px)] reveal" style="--d:210ms">
      <svg class="w-[26px] h-[26px] text-[#A83E32]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-handshake"/></svg>
      <h3 class="heading text-[clamp(17px,1.5vw,21px)] text-ink mt-1">Development partners</h3>
      <p class="text-[13px] leading-[1.55] text-body">Co-funded programmes and inclusive growth.</p>
    </div>
    <div class="bg-white flex flex-col gap-3 p-[clamp(20px,2vw,28px)] reveal" style="--d:280ms">
      <svg class="w-[26px] h-[26px] text-teal" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-rocket"/></svg>
      <h3 class="heading text-[clamp(17px,1.5vw,21px)] text-ink mt-1">Companies &amp; start-ups</h3>
      <p class="text-[13px] leading-[1.55] text-body">Clients, sponsors, members and pilot partners.</p>
    </div>
  </div>
</section>
