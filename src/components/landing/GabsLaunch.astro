---
// GABS Launch section — V2: Summit Programme with two session cards
---
<!-- =====================================================================
     THE SUMMIT SECTION — Programme and audience
     ===================================================================== -->
<div class="summit-section">
  <div class="page-shell">
    <div class="programme" id="programme">
      <div class="programme-heading">
        <div>
          <p class="eyebrow">24–25 November 2026</p>
          <h2>The Hub's launch programme.</h2>
        </div>
        <a class="summit-mark" href="https://www.gabs2026.com/" target="_blank" rel="noopener noreferrer">
          <img
            src="/img/partners/GABS_2026_logo_white.png"
            width="1181"
            height="406"
            alt="6th German-African Business Summit, 23–25 November 2026"
          >
        </a>
      </div>

      <div class="programme-grid">
        <article class="session session-launch">
          <div class="session-date">
            <span>24</span>
            <div>NOVEMBER<br>TUESDAY</div>
          </div>
          <div class="session-info">
            <h3>Official launch</h3>
            <p>Meet the Hub and the people shaping the Ghana–Europe AI connection.</p>
            <div class="session-meta">
              <time datetime="2026-11-24T15:00:00Z">15:00–17:00 GMT</time>
              <span>Westerwelle Startup Haus, Accra</span>
            </div>
          </div>
        </article>

        <article class="session session-showcase">
          <div class="session-date">
            <span>25</span>
            <div>NOVEMBER<br>WEDNESDAY</div>
          </div>
          <div class="session-info">
            <h3>Live AI showcase &amp; panel</h3>
            <p>Ghanaian AI solutions in action, followed by a discussion on Ghana–Europe collaboration.</p>
            <div class="session-meta">
              <time datetime="2026-11-25T10:00:00Z">10:00–12:00 GMT</time>
              <span>Kempinski Hotel Gold Coast City, Accra</span>
            </div>
          </div>
        </article>
      </div>

      <div class="programme-footer">
        <p>Free registration is for the AI showcase and panel on 25 November.</p>
        <a class="text-link" href="/get-involved#register">Register for free</a>
      </div>
    </div>

    <div class="event-audiences">
      <h3>Who should attend</h3>
      <ul>
        <li>European corporates exploring AI delivery capacity and talent</li>
        <li>Investors and development finance institutions</li>
        <li>Ghanaian AI companies, start-ups and researchers</li>
        <li>Government, policymakers and ecosystem partners</li>
      </ul>
    </div>
  </div>
</div>
