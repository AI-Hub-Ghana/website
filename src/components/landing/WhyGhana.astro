---
// Who We Are section — Statement hero and focused bilateral bridge visual
---
<!-- =====================================================================
     WHO WE ARE
     ===================================================================== -->
<section id="why" class="scroll-mt-24 border-t border-hairline relative overflow-clip bg-paper">
  <div class="shell py-[clamp(48px,6vw,88px)]">
    <div class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(0,42%)] gap-x-[clamp(28px,4vw,72px)] gap-y-10 items-center">
      
      <!-- Left: Tag, Headline, Full Description & Supporting Mission Note -->
      <div class="flex flex-col gap-6 reveal">
        <!-- 01 / WHO WE ARE tag -->
        <p class="kicker">
          01 / WHO WE ARE
        </p>

        <!-- Aligned heading -->
        <h2 id="about-title" class="display d-lg text-ink" style="--d:80ms">
          The bridge between<br class="hidden sm:inline" /> <span class="text-coral">Ghana and Europe.</span>
        </h2>

        <!-- Description -->
        <div class="flex flex-col gap-4 text-body text-[15px] sm:text-[16px] leading-[1.7] max-w-[48ch]" style="--d:140ms">
          <p>
            AI Hub, Ghana is a not-for-profit initiative connecting Ghana's growing artificial intelligence ecosystem with Europe. Ghana brings strong AI talent, entrepreneurial energy and government backing through its National AI Strategy. The Hub creates a structured route to European markets.
          </p>
          <p>
            We help European organisations access Ghanaian talent and solutions, while connecting Ghanaian companies and professionals with European clients, projects and partnerships.
          </p>
        </div>
      </div>

      <!-- Right: Simplified, cohesive Corridor Blueprint Panel -->
      <div class="relative w-full flex items-center justify-center lg:justify-end reveal" style="--d:120ms">
        <div class="w-full max-w-[420px] bg-blueprint-grid text-paper panel-hook-br border border-hairline/30 p-7 sm:p-9 flex flex-col gap-6 shadow-md relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-extrabold tracking-[0.2em] uppercase text-paper/75">
              The Corridor
            </span>
            <span class="tag tag-teal text-[9.5px] py-1 px-3">Bilateral bridge</span>
          </div>

          <div class="flex items-center justify-between font-extrabold text-[20px] sm:text-[23px] tracking-tight text-white uppercase">
            <span>Accra</span>
            <span class="text-gold text-[16px]">&harr;</span>
            <span>Europe</span>
          </div>

          <!-- Clean bidirectional corridor tracks -->
          <div class="flex flex-col gap-4 py-1" aria-hidden="true">
            <!-- Accra → Europe -->
            <div class="flex items-center w-full">
              <span class="w-[16px] h-[16px] rounded-full border-[3px] border-coral bg-white shrink-0"></span>
              <span class="h-[4px] bg-gold flex-1 -ml-[1px]"></span>
              <svg class="w-6 h-6 text-white shrink-0 -ml-[1px]" viewBox="0 0 28 28" fill="currentColor">
                <polygon points="4,2 26,14 4,26" />
              </svg>
            </div>

            <!-- Europe → Accra -->
            <div class="flex items-center w-full">
              <svg class="w-6 h-6 text-white shrink-0 -mr-[1px]" viewBox="0 0 28 28" fill="currentColor">
                <polygon points="24,2 2,14 24,26" />
              </svg>
              <span class="h-[4px] bg-mint flex-1 -mr-[1px]"></span>
              <span class="w-[16px] h-[16px] rounded-full border-[3px] border-mint bg-white shrink-0"></span>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-white/15 pt-3">
            <p class="text-[10.5px] font-extrabold tracking-[0.2em] uppercase text-paper/70">
              One ecosystem. Two markets.
            </p>
            <span class="w-2.5 h-2.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- The four-colour corridor bar, reading Accra to Europe -->
  <div class="corridor reveal" data-scrub="enter" aria-hidden="true">
    <i class="bg-coral" style="width:26%"></i>
    <i class="bg-gold"  style="width:22%"></i>
    <i class="bg-mint"  style="width:24%"></i>
    <i class="bg-teal"  style="width:28%"></i>
  </div>
</section>
