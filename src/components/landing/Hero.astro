---
// Hero section — V3: Launch-programme hero (no photo, programme cards right)
---
<!-- =====================================================================
     LAUNCH HERO — two-column: copy left, programme cards right
     ===================================================================== -->
<section class="launch-hero" id="launch" aria-labelledby="hero-title">
  <div class="page-shell">
    <div class="hero-grid">

      <!-- LEFT: copy -->
      <div class="hero-copy">
        <p class="event-eyebrow"><span aria-hidden="true"></span> AI Hub, Ghana · GABS 2026 side event</p>
        <h1 id="hero-title">Meet Ghana's AI.<br><span>Live in Accra.</span></h1>
        <p class="event-full-name">The Hub's launch programme · 24–25 November 2026</p>
        <p class="hero-description">
          Meet the people shaping the Ghana–Europe AI connection,
          see Ghanaian AI solutions in action, and explore new partnerships.
        </p>
        <div class="hero-actions">
          <a class="button button-teal hero-cta-full" href="/get-involved#register">Register for free</a>
        </div>
      </div>

      <!-- RIGHT: programme cards -->
      <div class="hero-programme" aria-label="Launch programme">

        <article class="prog-card prog-card--launch">
          <div class="prog-date">
            <span class="prog-day">24</span>
            <div class="prog-month">NOV<br>TUESDAY</div>
          </div>
          <div class="prog-body">
            <h2 class="prog-title">Official launch</h2>
            <p class="prog-desc">Meet the Hub and the people shaping the Ghana–Europe AI connection.</p>
            <div class="prog-meta">
              <time datetime="2026-11-24T15:00:00Z">15:00–17:00 GMT</time>
              <span>Westerwelle Startup Haus, Accra</span>
            </div>
          </div>
        </article>

        <article class="prog-card prog-card--showcase">
          <div class="prog-date">
            <span class="prog-day">25</span>
            <div class="prog-month">NOV<br>WEDNESDAY</div>
          </div>
          <div class="prog-body">
            <h2 class="prog-title">Live AI showcase &amp; panel</h2>
            <p class="prog-desc">Ghanaian AI solutions in action, followed by a discussion on Ghana–Europe collaboration.</p>
            <div class="prog-meta">
              <time datetime="2026-11-25T10:00:00Z">10:00–12:00 GMT</time>
              <span>Kempinski Hotel Gold Coast City, Accra</span>
            </div>
          </div>
        </article>

      </div>

    </div>
  </div>
</section>
