---
// Hero section — V4: headline left, event session cards right (2026-09-19 refactor)
---
<!-- =====================================================================
     LAUNCH HERO — two-column: copy left, session cards right
     ===================================================================== -->
<section class="launch-hero" id="launch" aria-labelledby="hero-title">
  <div class="page-shell">
    <div class="hero-grid">

      <!-- LEFT: copy -->
      <div class="hero-copy">
        <h1 id="hero-title">Meet Ghana's AI.<br><span>Live in Accra.</span></h1>
        <p class="event-full-name">The Hub's launch programme · <time datetime="2026-11-24/2026-11-25">24–25 November 2026</time></p>
        <p class="hero-description">
          Meet the people shaping the Ghana–Europe AI connection,
          see Ghanaian AI solutions in action, and explore new partnerships.
        </p>
        <div class="hero-actions">
          <a class="button button-teal" href="/get-involved#register">Register for free</a>
        </div>
      </div>

      <!-- RIGHT: programme cards -->
      <div class="hero-programme" id="programme" role="group" aria-label="Launch programme">

        <article class="session session-launch">
          <div class="session-date">
            <span>24</span>
            <div>NOV<br>TUESDAY</div>
          </div>
          <div class="session-info">
            <h3>Official launch</h3>
            <p>Meet the Hub and the people shaping the Ghana–Europe AI connection.</p>
            <div class="session-meta">
              <time datetime="2026-11-24T15:00:00Z">15:00–17:00 GMT</time>
              <span>Westerwelle Startup Haus, Accra</span>
            </div>
          </div>
        </article>

        <article class="session session-showcase">
          <div class="session-date">
            <span>25</span>
            <div>NOV<br>WEDNESDAY</div>
          </div>
          <div class="session-info">
            <h3>Live AI showcase &amp; panel</h3>
            <p>Ghanaian AI solutions in action, followed by a discussion on Ghana–Europe collaboration.</p>
            <div class="session-meta">
              <time datetime="2026-11-25T10:00:00Z">10:00–12:00 GMT</time>
              <span>Kempinski Hotel Gold Coast City, Accra</span>
            </div>
          </div>
        </article>

      </div>

    </div>
  </div>
</section>
