---
// Hero section — V2: Event-led Launch Hero
---
<!-- =====================================================================
     LAUNCH HERO — GABS 2026 side event focus
     ===================================================================== -->
<section class="launch-hero" id="launch" aria-labelledby="hero-title">
  <div class="page-shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="event-eyebrow"><span aria-hidden="true"></span> AI Hub, Ghana · GABS 2026 side event</p>
        <h1 id="hero-title">Meet Ghana's AI.<br><span>Live in Accra.</span></h1>
        <p class="event-full-name">Live AI showcase &amp; panel discussion</p>
        <p class="event-date">
          <time datetime="2026-11-25">25 November 2026</time>
          <span aria-hidden="true">·</span>
          <time datetime="2026-11-25T10:00:00Z">10:00–12:00 GMT</time>
        </p>
        <p class="event-venue">Kempinski Hotel Gold Coast City, Accra</p>
        <p class="hero-description">Meet Ghanaian AI talent, see practical demonstrations and explore new partnerships between Ghana and Europe.</p>
        <div class="hero-actions">
          <a class="button button-teal" href="/get-involved#register">Register for free</a>
        </div>
      </div>

      <div class="hero-photo-wrap">
        <span class="photo-accent photo-accent-gold" aria-hidden="true"></span>
        <figure class="hero-photo">
          <img
            class="drift"
            data-scrub="through"
            src="/img/photos/team-wide-02.png"
            width="1672"
            height="941"
            fetchpriority="high"
            decoding="async"
            alt="Illustrative scene of five colleagues discussing a project around laptops in a bright workspace"
          >
        </figure>
        <span class="photo-accent photo-accent-brick" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
