---
// Page head and wide team photo
---
<!-- =====================================================================
     PAGE HEAD
     ===================================================================== -->
<section class="shell pt-[clamp(24px,3vw,44px)] pb-[clamp(22px,2.6vw,40px)]">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div class="flex flex-col gap-3 reveal">
      <h1 class="display d-md">
        Get involved. Join the community.
      </h1>
    </div>

    <div class="flex flex-col gap-4 reveal" style="--d:100ms">
      <a href="#register" class="link self-start">
        Go to the form <svg class="w-[15px] h-[15px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-down"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- A wide band, where the landing page uses a tall portrait crop. Same
     brand, unmistakably a different page. -->
<div class="shell pb-[clamp(30px,3.6vw,56px)]">
  <div class="hook-tl reveal aspect-[4/3] sm:aspect-[2/1] overflow-hidden">
    <picture class="w-full h-full block">
      <source srcset="/images/photos/team-wide-01.webp" type="image/webp">
      <img src="/images/photos/team-wide-01.png" width="1672" height="941" loading="lazy" decoding="async"
           alt="A team working together around a table in Accra" class="w-full h-full object-cover">
    </picture>
  </div>
</div>
