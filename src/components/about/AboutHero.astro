<section class="about-hero ah-grid" aria-labelledby="about-title">
  <div class="shell about-hero__inner">
    <div class="about-hero__kicker">
      <p class="kicker">ABOUT AI HUB GHANA</p>
      <span class="about-hero__rule" aria-hidden="true"></span>
    </div>

    <div class="about-hero__copy">
      <h1 id="about-title" class="display d-xl">The talent is here.<br /><span class="about-accent">The route was not.</span></h1>
      <p class="lead">AI Hub Ghana creates a structured connection between Ghanaian AI talent, entrepreneurship and international opportunity.</p>
    </div>

    <!-- Right side: Corridor Blueprint visual with black grid background -->
    <div class="about-hero__visual" aria-label="Hub corridor blueprint visual">
      <div class="w-full max-w-[400px] bg-blueprint-grid text-paper panel-hook-br border border-hairline/30 p-6 sm:p-7 flex flex-col gap-5 shadow-lg relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-extrabold tracking-[0.2em] uppercase text-paper/75">
            Accra
          </span>
          <span class="tag tag-teal text-[9.5px] py-1 px-3">Bilateral bridge</span>
        </div>

        <div class="flex items-center justify-between font-extrabold text-[19px] sm:text-[22px] tracking-tight text-white uppercase">
          <span>Ghana</span>
          <span class="text-gold text-[16px]">&harr;</span>
          <span>Europe</span>
        </div>

        <!-- Clean bidirectional corridor tracks -->
        <div class="flex flex-col gap-3 py-1" aria-hidden="true">
          <!-- Ghana → Europe -->
          <div class="flex items-center w-full">
            <span class="w-[14px] h-[14px] rounded-full border-[3px] border-coral bg-white shrink-0"></span>
            <span class="h-[3.5px] bg-gold flex-1 -ml-[1px]"></span>
            <svg class="w-5 h-5 text-white shrink-0 -ml-[1px]" viewBox="0 0 28 28" fill="currentColor">
              <polygon points="4,2 26,14 4,26" />
            </svg>
          </div>

          <!-- Europe → Ghana -->
          <div class="flex items-center w-full">
            <svg class="w-5 h-5 text-white shrink-0 -mr-[1px]" viewBox="0 0 28 28" fill="currentColor">
              <polygon points="24,2 2,14 24,26" />
            </svg>
            <span class="h-[3.5px] bg-mint flex-1 -mr-[1px]"></span>
            <span class="w-[14px] h-[14px] rounded-full border-[3px] border-mint bg-white shrink-0"></span>
          </div>
        </div>

        <div class="flex items-center justify-between border-t border-white/15 pt-3">
          <p class="text-[10.5px] font-extrabold tracking-[0.18em] uppercase text-paper/75">
            AI · Talent · Opportunity
          </p>
          <span class="w-2.5 h-2.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
