---
// Navbar — V2: working-name logotype, event-focused nav links
interface Props {
  currentPage?: 'home' | 'get-involved';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
const logoHref = '/';

// On home: anchor links. On get-involved: cross-page links
const launchHref   = isHome ? '#launch' : '/#launch';
const whyHref      = isHome ? '#why'    : '/#why';
const workHref     = isHome ? '#work'   : '/#work';
const registerHref = isHome ? '/get-involved#register' : '#register';
---

<header class="site-header" id="nav">
  <div class="shell header-inner">
    <!-- Working-name placeholder only. No final logo or brand name has been approved. -->
    <a class="brand" href={logoHref} aria-label="AI Hub, Ghana — home">
      <span class="brand-placeholder">
        <span>AI HUB</span>
        <span>GHANA</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={launchHref} class={isHome ? 'active' : ''}>The launch</a>
      <a href={whyHref}>Who we are</a>
      <a href={workHref}>What we do</a>
      <a href="mailto:b.janischowsky@4th-ir.com">Contact us</a>
    </nav>

    <a class="nav-cta" href={registerHref}>Register for free</a>

    <button
      class="menu-button"
      type="button"
      id="menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu <span aria-hidden="true">+</span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-menu" hidden aria-label="Mobile navigation">
    <a href={launchHref}>The launch</a>
    <a href={whyHref}>Who we are</a>
    <a href={workHref}>What we do</a>
    <a href={registerHref}>Register for free</a>
    <a href="mailto:b.janischowsky@4th-ir.com">Contact us</a>
  </nav>
</header>
