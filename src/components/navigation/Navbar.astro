---
// Navbar — V2: working-name logotype, event-focused nav links
interface Props {
  currentPage?: 'home' | 'get-involved' | 'not-found';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
const isGetInvolved = currentPage === 'get-involved';
const logoHref = '/';

// Use homepage anchors from every route except the homepage itself.
const whyHref      = isHome ? '#why'    : '/#why';
const workHref     = isHome ? '#work'   : '/#work';
const registerHref = isGetInvolved ? '#register' : '/get-involved#register';
const contactHref  = isGetInvolved ? '#register' : '/get-involved#register';
---

<header class="site-header" id="nav">
  <div class="shell header-inner">
    <!-- Working-name placeholder only. No final logo or brand name has been approved. -->
    <a class="brand" href={logoHref} aria-label="Applied AI &amp; Innovation Centre, Ghana — home">
      <img
        class="brand-logo"
        src="/images/logo_black.svg"
        width="296"
        height="99"
        alt="Applied AI &amp; Innovation Centre, Ghana"
      >
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={whyHref}>Who we are</a>
      <a href={workHref}>What we do</a>
      <a href={contactHref}>Contact us</a>
    </nav>

    <a class="nav-cta" href={registerHref}>Register for free</a>

    <button
      class="menu-button"
      type="button"
      id="menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu <span aria-hidden="true">+</span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-menu" hidden aria-label="Mobile navigation">
    <a href={whyHref}>Who we are</a>
    <a href={workHref}>What we do</a>
    <a href={registerHref}>Register for free</a>
    <a href={contactHref}>Contact us</a>
  </nav>
</header>
