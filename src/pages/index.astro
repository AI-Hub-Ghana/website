---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import GabsLaunch from '../components/landing/GabsLaunch.astro';
import WhyGhana from '../components/landing/WhyGhana.astro';
import WorkAreas from '../components/landing/WorkAreas.astro';
import Corridor from '../components/landing/Corridor.astro';
import Membership from '../components/landing/Membership.astro';
import StatBand from '../components/landing/StatBand.astro';
import Partners from '../components/landing/Partners.astro';
import JoinCTA from '../components/landing/JoinCTA.astro';

const title = "AI Hub, Ghana — the bridge between Ghana and Europe";
const description = "A not-for-profit AI innovation centre in Accra, and a bilaterally governed bridge between Ghana's AI ecosystem and European markets. European organisations gain trusted access to Ghanaian AI talent and solutions; Ghanaian companies, entrepreneurs and AI professionals gain access to European clients, projects and partnerships.";
---

<BaseLayout
  title={title}
  description={description}
  printPageSize="1600px 8800px"
  currentPage="home"
>
  <Hero />
  <GabsLaunch />
  <WhyGhana />
  <WorkAreas />
  <Corridor />
  <Membership />
  <StatBand />
  <Partners />
  <JoinCTA />
</BaseLayout>
