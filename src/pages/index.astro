---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import GabsLaunch from '../components/landing/GabsLaunch.astro';
import WhyGhana from '../components/landing/WhyGhana.astro';
import WorkAreas from '../components/landing/WorkAreas.astro';
import Partners from '../components/landing/Partners.astro';
import JoinCTA from '../components/landing/JoinCTA.astro';

const title = "AI Hub, Ghana — launch & live AI showcase";
const description = "Join the AI Hub, Ghana launch and live AI showcase at GABS 2026 in Accra. Connect Ghanaian AI talent, teams and solutions with European projects and partnerships.";
---

<BaseLayout
  title={title}
  description={description}
  printPageSize="1600px 8800px"
  currentPage="home"
>
  <Hero />
  <GabsLaunch />
  <WhyGhana />
  <WorkAreas />
  <Partners />
  <JoinCTA />
</BaseLayout>
