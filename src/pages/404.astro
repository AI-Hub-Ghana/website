---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page not found — AI Hub, Ghana';
const description = 'The page you are looking for could not be found.';
---

<BaseLayout
  title={title}
  description={description}
  currentPage="not-found"
  mainClass="not-found-main"
  noindex={true}
>
  <section class="not-found page-shell" aria-labelledby="not-found-title">
    <div class="not-found-content">
      <p class="eyebrow">Error 404</p>
      <p class="not-found-number" aria-hidden="true">404</p>
      <h1 id="not-found-title">We can’t find that page.</h1>
      <p class="not-found-description">The link may be out of date, or the address may have been entered incorrectly.</p>
      <nav class="not-found-actions" aria-label="Next steps">
        <a class="button button-teal" href="/">Back to the homepage</a>
        <a class="text-link" href="/get-involved#register">Register for free</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body.launch-page) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  :global(.not-found-main) {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding-block: 32px;
  }

  .not-found-content {
    width: 100%;
    max-width: 760px;
    text-align: center;
  }

  .not-found-number {
    margin: 18px 0 26px;
    color: #dcece4;
    font-size: 184px;
    font-weight: 750;
    line-height: 0.8;
  }

  .not-found h1 {
    max-width: 680px;
    margin: 0;
    font-size: 56px;
    font-weight: 650;
    line-height: 1.08;
  }

  .not-found-description {
    max-width: 520px;
    margin: 20px 0 30px;
    margin-inline: auto;
    color: #5a554c;
    font-size: 16px;
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  @media (max-width: 600px) {
    .not-found {
      padding-block: 24px;
    }

    .not-found-number {
      margin-block: 18px 26px;
      font-size: 120px;
    }

    .not-found h1 {
      font-size: 40px;
    }

    .not-found-description {
      font-size: 14px;
    }

    .not-found-actions {
      align-items: center;
      flex-direction: column;
      gap: 16px;
    }
  }

  @media (max-height: 700px) {
    .not-found {
      padding-block: 16px;
    }

    .not-found-number {
      margin-block: 12px 20px;
      font-size: 120px;
    }

    .not-found h1 {
      font-size: 40px;
    }

    .not-found-description {
      margin-block: 12px 20px;
    }
  }
</style>