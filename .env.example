# Google Sheets Registration Integration
# Required credentials for Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional Google Sheet settings
# GOOGLE_SHEET_NAME=Registrations
# GOOGLE_SHEET_RANGE=A:L

# Production Site URL (used for canonical links and OpenGraph images)
# PUBLIC_SITE_URL=https://ai-hub-ghana.org
